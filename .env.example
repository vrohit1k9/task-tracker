# Environment Configuration
NODE_ENV=development
PORT=5000

# Database Settings (Mongoose)
# For local dev: mongodb://127.0.0.1:27017/student-task-tracker
# For docker dev: mongodb://db:27017/student-task-tracker
MONGO_URI=mongodb://127.0.0.1:27017/student-task-tracker

# JWT Authentication Configuration
# Make sure to generate secure, long random strings in production
JWT_SECRET=development_jwt_access_secret_longer_key_32_chars
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=development_jwt_refresh_secret_longer_key_64_chars
JWT_REFRESH_EXPIRES_IN=7d
